{
  "name": "@meridian-flow/gateway",
  "version": "0.1.0",
  "description": "Provider-neutral streaming model gateway: Anthropic, OpenAI, Gemini and OpenAI-compatible adapters with retry, deadlines and usage normalization.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haowjy/meridian-runtime.git",
    "directory": "packages/gateway"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "default": "./dist/shapes/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./mock-script": {
      "types": "./dist/mock-script.d.ts",
      "default": "./dist/mock-script.js"
    }
  },
  "meridianRuntime": {
    "nodeFreeEntries": [
      ".",
      "./shapes"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@google/genai": "catalog:",
    "jsonrepair": "catalog:",
    "openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
