{
  "name": "@meridian-flow/runtime",
  "version": "0.2.0",
  "description": "What an AI product needs to run models: a provider-neutral streaming model gateway (Anthropic, OpenAI, Gemini, OpenAI-compatible) with retry, deadlines and usage normalization, and an MCP client.",
  "keywords": [
    "llm",
    "ai",
    "model-gateway",
    "anthropic",
    "openai",
    "gemini",
    "streaming",
    "workload-identity-federation",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haowjy/meridian-runtime.git"
  },
  "homepage": "https://github.com/haowjy/meridian-runtime#readme",
  "bugs": {
    "url": "https://github.com/haowjy/meridian-runtime/issues"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./gateway/shapes": {
      "types": "./dist/gateway/shapes/index.d.ts",
      "default": "./dist/gateway/shapes/index.js"
    },
    "./gateway/mock": {
      "types": "./dist/gateway/mock.d.ts",
      "default": "./dist/gateway/mock.js"
    },
    "./gateway/mock-script": {
      "types": "./dist/gateway/mock-script.d.ts",
      "default": "./dist/gateway/mock-script.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "meridianRuntime": {
    "nodeFreeEntries": [
      "./gateway",
      "./gateway/shapes"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "pnpm run build",
    "lint": "biome check .",
    "format:write": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:package": "node tools/check-package.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "jsonrepair": "^3.15.0",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
