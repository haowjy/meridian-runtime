{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/node_modules", "!**/dist", "!**/.context"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noProcessEnv": {
          "level": "error",
          "options": {}
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["tools/**", "**/*.test.ts", "src/mcp/testing/**"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["src/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../gateway", "../gateway/*"],
                    "message": "./mcp imports nothing from ./gateway."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp/gateway-types.test.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["src/gateway/shapes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "@anthropic-ai/*", "@google/*", "openai", "openai/*"],
                    "message": "./shapes reaches browser bundles: no Node built-ins and no SDKs."
                  },
                  {
                    "group": ["../*"],
                    "message": "./shapes imports only its own files, so the browser bundle never pulls in the rest of the gateway."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
